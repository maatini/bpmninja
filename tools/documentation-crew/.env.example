# Pflicht für den Standardprovider DeepSeek
DEEPSEEK_API_KEY=

# Modelle (jedes LiteLLM-kompatible Modell ist möglich)
DOC_CREW_MODEL=deepseek/deepseek-chat
DOC_CREW_MANAGER_MODEL=deepseek/deepseek-chat

# Optional: low, medium, high, max. Leer lassen, wenn der Provider den
# Parameter nicht unterstützt.
DOC_CREW_EFFORT=

# Kreativität der Textgenerierung (0.0 = deterministisch, 1.0 = sehr frei).
DOC_CREW_TEMPERATURE=0.2

# Verhalten bei fehlgeschlagenen Tool-Aufrufen: raise, warn oder ignore.
DOC_CREW_TOOL_FAILURE_POLICY=warn

# Memory: 1 = an, 0 = aus. ONNX lädt beim ersten Speichern ein lokales
# MiniLM-Modell (ca. 80 MB); dafür ist kein OpenAI-Key nötig.
DOC_CREW_MEMORY=1
DOC_CREW_EMBEDDER=onnx

# Optional: bessere Websuche. Ohne Key nutzt die Crew Bing-RSS mit
# DuckDuckGo-Fallback.
SERPER_API_KEY=

# Optional: GitHub-Token für spätere Erweiterungen
GITHUB_TOKEN=
