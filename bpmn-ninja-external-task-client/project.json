{
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "name": "client",
  "root": "bpmn-ninja-external-task-client",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "npm run build",
        "cwd": "{projectRoot}"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "npm run lint",
        "cwd": "{projectRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "rustSources"],
      "options": {
        "command": "npm test",
        "cwd": "{projectRoot}"
      }
    }
  }
}
